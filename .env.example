# Unvoice backend configuration. Copy to backend/.env for local dev.

# --- Storage ---
STORAGE_BACKEND=local
STORAGE_DIR=./storage
JOB_TTL_SECONDS=3600

# --- Demucs ---
DEMUCS_MODEL=htdemucs
DEMUCS_DEVICE=cpu
# Override torch hub cache location (set to /models inside Docker)
# TORCH_HOME=

# --- API ---
MAX_UPLOAD_MB=50
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
# (frontend reads its own .env via Vite — see frontend/.env.example)
